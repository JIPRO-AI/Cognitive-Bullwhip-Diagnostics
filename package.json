{
  "name": "@agdp/structured-cognition",
  "version": "1.2.0",
  "description": "MCP server for Structured Cognition Protocol — 6 middleware tools that diagnose and contain reasoning amplification in AI agent systems",
  "type": "module",
  "bin": {
    "structured-cognition": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --noCheck",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "demo:replay": "tsx scripts/demo-replay.ts",
    "test": "tsx test/e2e-all.ts && tsx test/determinism.ts",
    "test:e2e": "tsx test/e2e-all.ts",
    "test:determinism": "tsx test/determinism.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "structured-cognition",
    "agent-reasoning",
    "cognitive-bullwhip",
    "signal-anchor",
    "logic-stack",
    "causal-mesh",
    "principle-gate",
    "ai-agent",
    "reasoning-middleware",
    "deterministic-middleware",
    "reasoning-validation",
    "agent-governance",
    "decision-diagnostics"
  ],
  "author": "JIPRO589",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JIPRO589/Cognitive-Bullwhip-Diagnostics"
  },
  "homepage": "https://github.com/JIPRO589/Cognitive-Bullwhip-Diagnostics"
}
